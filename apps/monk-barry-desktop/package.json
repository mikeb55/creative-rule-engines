{
  "name": "monk-barry-desktop",
  "version": "1.0.0",
  "description": "Monk / Barry Harris Engine Desktop Test App",
  "main": "dist-electron/main.js",
  "author": "Creative Rule Engines",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ../../scripts/build-engine.mjs && electron-builder --win",
    "postbuild": "powershell -ExecutionPolicy Bypass -File ../../scripts/create-desktop-shortcut.ps1",
    "electron:dev": "node ../../scripts/build-engine.mjs && concurrently \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:build": "tsc && vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.creative-rule-engines.monk-barry-desktop",
    "productName": "Monk Barry Composer",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "assets/**/*"],
    "forceCodeSigning": false,
    "win": {
      "target": ["portable", "nsis"],
      "icon": "assets/app-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Monk Barry Composer"
    }
  }
}
