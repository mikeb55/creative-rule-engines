{
  "name": "monk-composer",
  "productName": "Monk Composer",
  "version": "1.0.0",
  "description": "Creative rule-based composition app combining Barry Harris and Monk engines",
  "main": "dist-electron/main.js",
  "author": "Creative Rule Engines",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --win",
    "build:win": "tsc && vite build && electron-builder --win",
    "postbuild": "node scripts/create-desktop-shortcut.js",
    "install-and-build": "node scripts/build-and-install.js",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc && vite build && electron-builder --win",
    "generate-quartet-demo": "npx tsx scripts/generate-quartet-demo.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.creative-rule-engines.monk-composer",
    "productName": "Monk Composer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../../engines/",
        "to": "engines",
        "filter": [
          "**/*.md"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/app-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Monk Composer"
    }
  }
}
